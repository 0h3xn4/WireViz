# Build environment for release packages: Ubuntu 22.04 (glibc 2.35), so the result also starts on 24.04.
# Build the image on a connected machine, then build packages from it:
#   docker build -f packaging/ubuntu/container/Dockerfile.build-22.04 -t harness-build:22.04 .
#   docker run --rm -v "$PWD":/src -w /src harness-build:22.04 ./packaging/ubuntu/container/build-in-container.sh
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
# Python 3.12 is not in the 22.04 archive: it comes from the deadsnakes PPA (needs the network, once).
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common gpg-agent \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv git ca-certificates dpkg-dev \
    libegl1 libgl1 libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libdbus-1-3 libxcb-cursor0 \
    libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
 && rm -rf /var/lib/apt/lists/*
